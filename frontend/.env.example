# RPC endpoint used by the frontend (e.g. an Alchemy/Infura URL, or a local Anvil node)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Chain ID the app should connect to (31337 for local Anvil)
NEXT_PUBLIC_CHAIN_ID=31337

# Deployed contract addresses (populate after running the DeployRegistry / DeployStockvel scripts)
NEXT_PUBLIC_USER_REGISTRY_ADDRESS=
NEXT_PUBLIC_STOCKVEL_FACTORY_ADDRESS=
